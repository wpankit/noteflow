<?xml version="1.0"?>
<ruleset name="NoteFlow">
	<description>WordPress coding standards and PHP 7.4+ compatibility for NoteFlow.</description>

	<!-- What to check. -->
	<file>.</file>
	<exclude-pattern>/.git/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<!-- Scripts that build the wordpress.org listing assets; not part of the plugin. -->
	<exclude-pattern>/tools/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- Match the plugin header: WordPress 6.0+ and PHP 7.4+. -->
	<config name="minimum_wp_version" value="6.0"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="noteflow"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="noteflow"/>
			</property>
		</properties>
	</rule>
</ruleset>
